# LiveKit Cloud (https://cloud.livekit.io) → Settings → Keys
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Supabase (https://app.supabase.com → Project Settings → API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY     # gizli! sadece sunucuda
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET            # Settings → API → JWT Secret
# Not: SUPABASE_JWT_SECRET boşsa sunucu "geliştirme modunda" çalışır
# (kimlik body/query/x-user-id'den alınır). Üretimde mutlaka doldur.

# Sunucu portu
PORT=3000

# Eşleştirme ayarları
MATCH_MIN=2
MATCH_IDEAL=4
MATCH_RELAX_MS=20000

# Freemium & moderasyon
FREE_DAILY_ROOMS=2            # ücretsiz kullanıcı günlük oda limiti
REPORT_EJECT_THRESHOLD=2      # aynı odada kaç farklı rapor → otomatik çıkarma
# DEV_PREMIUM — 1 YAPARSAN SUNUCU HERKESI PREMIUM SAYAR.
# entitlements.js'in ilk satiri: if (DEV_PREMIUM === "1") return true;
# Yani odeme kontrolu tamamen devre disi kalir - senaryo, koc sohbeti,
# premium okuma limitleri herkese acilir. Kimse sikayet etmez, sadece
# kimse para odemez; fark etmesi cok zor bir arizadir.
# URETIMDE (Render) ASLA 1 OLMAMALI. Yerelde test icin gecici acip
# is bitince 0'a cek.
DEV_PREMIUM=0
REVENUECAT_WEBHOOK_TOKEN=     # RevenueCat webhook doğrulama (Bearer)
