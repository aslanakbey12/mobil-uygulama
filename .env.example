# ═══════════════════════════════════════════════════════════════════════════
#  LIVEDA SUNUCU — ORTAM DEĞİŞKENLERİ
# ═══════════════════════════════════════════════════════════════════════════
#
# Bu dosya kodun GERÇEKTEN okuduğu her değişkeni listeler. Kurulum yaparken
# (özellikle Render'da) kontrol listesi olarak kullan.
#
# NEDEN EKSİKSİZ OLMASI ÖNEMLİ: bu dosya bir süre kodun okuduğu 44 değişkenin
# 14'ünü listeliyordu ve üstelik `.gitignore`'daki `.env.*` kuralı yüzünden
# HİÇ COMMIT EDİLMEMİŞTİ. Sonucu somut oldu — üretimde iki değişken eksik
# kaldı ve ikisi de sessizce zarar verdi:
#   · REVENUECAT_WEBHOOK_TOKEN yoktu → webhook her isteği 401'le reddediyordu,
#     yani satın alma alınsa bile premium açılmayacaktı
#   · AUTH_STRICT yoktu → sunucu doğrulanmamış x-user-id başlığına güveniyordu
#
# İşaretler:
#   [ZORUNLU]  boşsa ilgili özellik ÇALIŞMAZ
#   [GÜVENLİK] üretimde yanlış değer = açık kapı
#   [ayar]     varsayılanı var, dokunmasan da olur
#
# Değişken eklersen BURAYA DA EKLE. Kodda okunup burada yazmayan bir değişken,
# bir dahaki kurulumda yine eksik kalır.


# ── SUPABASE ────────────────────────────────────────────────── [ZORUNLU] ──
# Project Settings → API. SERVICE_KEY gizlidir, YALNIZCA sunucuda durur;
# istemciye asla konmaz (RLS'i aşar).
# Boşsa: kimlik doğrulama, ilerleme, koç, önbellek — hiçbiri çalışmaz.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY

# ── KİMLİK DOĞRULAMA ───────────────────────────────────────── [GÜVENLİK] ──
# 1  → yalnızca doğrulanmış Supabase token'ına güven (ÜRETİMDE BÖYLE OLMALI)
# 0/boş → doğrulanmamış x-user-id / body.userId başlığına da güvenir
#
# Kapalıyken herkes tek bir HTTP isteğiyle İSTEDİĞİ KULLANICI gibi davranabilir:
# başkasının ilerlemesini, koç raporunu, DM'lerini okuyabilir. Yalnızca yerel
# geliştirmede kapalı bırak.
AUTH_STRICT=1

# İzin verilen kaynaklar, virgülle. Varsayılan "*" (herkese açık).
# Üretimde kendi alan adlarını yaz.
CORS_ORIGINS=*

# ── YAPAY ZEKÂ ─────────────────────────────────────────────── [ZORUNLU] ──
# Boşsa okuma, koç, senaryo, sohbet ve çeviri SESSİZCE kapalı kalır —
# hata vermez, özellikler görünmez olur.
GEMINI_API_KEY=

# Sağlayıcı seçimi. Varsayılan "gemini"; değiştirmedikçe her şey aynen çalışır.
LLM_PROVIDER=gemini
# OpenRouter üzerinden gitmek istersen (ikisi birlikte):
LLM_API_KEY=
LLM_BASE_URL=
# LLM_API_KEY boşsa OPENROUTER_API_KEY yedek olarak okunur.
OPENROUTER_API_KEY=

# Model seçimleri [ayar]
GEMINI_MODEL=gemini-flash-latest
COACH_MODEL=gemini-pro-latest
REPORT_MODEL=deepseek/deepseek-v4-pro
UTIL_MODEL=deepseek/deepseek-v4-pro
# Boş bırakılırsa okuma da GEMINI_MODEL kullanır.
READING_MODEL=

# ── GÖRSELLER ───────────────────────────────────────────────────── [ayar] ──
# Boşsa kelime kartlarında görsel gösterilmez (istemci gizler, hata vermez).
PEXELS_API_KEY=

# ── PREMIUM & ÖDEME ────────────────────────────────────────── [GÜVENLİK] ──
# DEV_PREMIUM — 1 YAPARSAN SUNUCU HERKESİ PREMIUM SAYAR.
# entitlements.js'in ilk satırı: if (DEV_PREMIUM === "1") return true;
# Ödeme kontrolü tamamen devre dışı kalır. Kimse şikâyet etmez, sadece kimse
# para ödemez; fark etmesi çok zor bir arızadır. ÜRETİMDE ASLA 1 OLMASIN.
DEV_PREMIUM=0

# RevenueCat webhook doğrulaması. Üç yerde AYNI değer olmalı:
#   1) burada / Render Environment
#   2) RevenueCat → Integrations → Webhooks → Authorization: Bearer <değer>
# BOŞSA WEBHOOK HER İSTEĞİ REDDEDER (fail-closed) → satın alma alınır ama
# premium açılmaz. Üretmek için: openssl rand -hex 32
REVENUECAT_WEBHOOK_TOKEN=

# ── SESLİ ODA (LiveKit) ─────────────────────────────────────────── [ayar] ──
# Üçü birden dolu değilse sesli oda kapalı kalır (uygulama çalışmaya devam eder).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── SUNUCU ──────────────────────────────────────────────────────── [ayar] ──
PORT=3000
BODY_LIMIT=2097152

# ── HIZ SINIRI ──────────────────────────────────────────────────── [ayar] ──
RL_MAX=240
RL_WINDOW_MS=60000
AI_RL_MAX=20
AI_RL_WINDOW_MS=60000

# ── YZ KOTALARI ─────────────────────────────────────────────────── [ayar] ──
# Maliyet freni. Kullanıcı başına ve SİSTEM GENELİ tavan.
# Not: kalıcı olmaları için db/12_perf_quota.sql çalıştırılmış olmalı; yoksa
# sayaçlar yalnızca bellekte tutulur ve her yeniden başlatmada sıfırlanır.
AI_DAILY_CAP=300
AI_TRANSLATE_DAILY_CAP=600
AI_GLOBAL_DAILY_CAP=20000
AI_QUOTA_FLUSH_MS=60000
READING_DAILY_CAP=3
READING_DAILY_CAP_PREMIUM=30

# ── YZ SOHBETİ ──────────────────────────────────────────────────── [ayar] ──
AI_CHAT_MAX_TURNS=22
AI_CHAT_MIN_GAP_MS=1500

# ── SOSYAL / EŞLEŞTİRME ─────────────────────────────────────────── [ayar] ──
FREE_DAILY_ROOMS=2
REPORT_EJECT_THRESHOLD=2
INVITE_TTL_MIN=30
LEAGUE_WEEKLY_XP_CAP=50000
MATCH_MIN=2
MATCH_IDEAL=4
MATCH_RELAX_MS=20000
MATCH_BACKFILL_MS=45000
MATCH_OVERLAP_MIN=3
# 0 → bot ile doldurmayı kapat
MATCH_BOT_FILL=1
