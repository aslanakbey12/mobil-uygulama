{
  "name": "kelime-odalar-server",
  "version": "0.1.0",
  "description": "Eşleştirme (matchmaking) + LiveKit token servisi — sesli tartışma odaları MVP backend",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check": "node scripts/check-syntax.mjs && node scripts/env-check.mjs",
    "test": "node --experimental-test-module-mocks --test test/*.test.js",
    "eval": "node eval/run.mjs",
    "audit": "npm audit --omit=dev --audit-level=high",
    "env:check": "node scripts/env-check.mjs"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.0",
    "@supabase/supabase-js": "^2.108.2",
    "fastify": "^5.12.4",
    "jose": "^6.2.3",
    "livekit-server-sdk": "^2.7.0",
    "ws": "^8.21.0"
  },
  "engines": {
    "node": ">=20"
  }
}
